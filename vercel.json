{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lifting-life-admin": {
      "root": "lifting-life-admin",
      "framework": "vite"
    },
    "lifting-life-backend": {
      "root": "lifting-life-backend",
      "framework": "express",
      "entrypoint": "src/server.js",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "OPENGYM_API_URL"
        },
        {
          "type": "service",
          "service": "lifting-life-admin",
          "format": "url",
          "env": "ADMIN_FRONTEND_URL"
        }
      ]
    },
    "api": {
      "root": "openGym-main/api",
      "runtime": "node",
      "entrypoint": "server.js"
    },
    "frontend": {
      "root": "openGym-main/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

