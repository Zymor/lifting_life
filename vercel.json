{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lifting-life-admin": {
      "root": "lifting-life-admin",
      "framework": "vite"
    },
    "lifting-life-backend": {
      "root": "lifting-life-backend",
      "framework": "express",
      "entrypoint": "src/server.js",
      "bindings": [
        {
          "type": "service",
          "service": "lifting-life-admin",
          "format": "url",
          "env": "ADMIN_FRONTEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "lifting-life-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "lifting-life-admin"
      }
    }
  ]
}
